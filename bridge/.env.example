# Copy to bridge/.env and keep it private. Never commit or share .env.
# Generate a random token (paste the same token into the extension's settings):
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=

# Oxford Dictionaries API credentials (not Oxford Learner's Dictionaries/OED).
# Official Sandbox is limited to a-prefixed words and 500 trial calls.
OXFORD_APP_ID=
OXFORD_APP_KEY=
OXFORD_LANGUAGE=en-gb
OXFORD_SANDBOX=true

# Cambridge credentials require approved access. To choose a dictionary code,
# first set the key, start the bridge and request GET /v1/dictionaries with your
# Bearer token. Copy an authorized dictionaryCode here; restart the bridge.
CAMBRIDGE_ACCESS_KEY=
CAMBRIDGE_DICTIONARY_CODE=
